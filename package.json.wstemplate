{
  "author": "Bahram Joharshamshiri",
  "dependencies": {
    "lungo-ts": {% if env.MFR_LOCAL_LIBS %}"file:{{ build.root_from_here }}/lungo/distribution/ts"{% else %}"{{ projects.lungo.version }}"{% endif %}
  },
  "description": "JavaScript implementation of Tagged URN with strict validation and matching",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./tagged-urn.js"
  },
  "files": [
    "tagged-urn.js",
    "formal/index.js",
    "formal/index.d.ts",
    "formal/program.wasm",
    "RULES.md",
    "README.md"
  ],
  "keywords": [
    "tagged-urn",
    "urn",
    "namespace",
    "validation",
    "matching"
  ],
  "license": "MIT",
  "main": "tagged-urn.js",
  "name": "tagged-urn",
  "repository": {
    "directory": "tagged-urn-js",
    "type": "git",
    "url": "https://github.com/machinefabric/tagged-urn.git"
  },
  "scripts": {
    "test": "node tagged-urn.test.js"
  },
  "type": "module",
  "version": "{{ project.version }}"
}
